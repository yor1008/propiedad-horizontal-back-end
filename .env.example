# Copia este archivo a .env y completa los valores. .env esta ignorado por git.
# No escribas comentarios en la misma linea que un valor.

# Clave HS256, minimo 32 caracteres
JWT_SECRET=

BOOTSTRAP_ADMIN_CORREO=
# Minimo 8 caracteres
BOOTSTRAP_ADMIN_CONTRASENA=

# Reservado para OAuth2 / Google Cloud (futuro)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
