  "cards": [
    { "dot": "rose", "title": "Seguridad", "items": [
      "Solo login, olvidé y restablecer contraseña son públicos; todo lo demás exige Bearer JWT",
      "Sin sesión en el servidor: cada petición se valida solo con el token",
      "Cada método de controlador lleva su etiqueta de rol; SeguridadPorEtiquetaTest lo exige"
    ] },
    { "dot": "cyan", "title": "Al arrancar", "items": [
      "Flyway aplica las migraciones y Hibernate solo valida el esquema (ddl-auto=validate)",
      "Los ApplicationRunner de config/ siembran estados, catálogos, tipos de persona y el admin inicial",
      "Sin JWT_SECRET la aplicación no arranca"
    ] },
    { "dot": "amber", "title": "Correo y front", "items": [
      "Un solo adaptador de EnviadorCorreo se activa: Gmail API si existe GMAIL_REFRESH_TOKEN, si no SMTP",
      "Si la transacción se revierte, no sale ningún correo",
      "El front vive en su propio repositorio; su proxy prueba el back local y luego Render"
    ] }
  ]
